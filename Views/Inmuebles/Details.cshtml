@model PortalInmobiliario.Models.Inmueble
@using PortalInmobiliario.Data
@inject ApplicationDbContext _context

@{
    ViewData["Title"] = "Detalle del Inmueble";
    var reservaActiva = _context.Reservas
        .Any(r => r.InmuebleId == Model.Id && r.FechaExpiracion > DateTime.Now);
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <h1>@Model.Titulo</h1>
            <p class="text-muted">Código: @Model.Codigo</p>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <img src="@(Model.Imagen ?? "/img/placeholder.jpg")" class="img-fluid rounded mb-4" alt="@Model.Titulo">

            <div class="row mb-4">
                <div class="col-md-6">
                    <h4>Características</h4>
                    <ul class="list-unstyled">
                        <li><strong>Tipo:</strong> @Model.Tipo</li>
                        <li><strong>Ciudad:</strong> @Model.Ciudad</li>
                        <li><strong>Dirección:</strong> @Model.Direccion</li>
                        <li><strong>Dormitorios:</strong> @Model.Dormitorios</li>
                        <li><strong>Baños:</strong> @Model.Banos</li>
                        <li><strong>Metros Cuadrados:</strong> @Model.MetrosCuadrados m²</li>
                    </ul>
                </div>
                <div class="col-md-6">
                    <div class="card bg-light">
                        <div class="card-body text-center">
                            <h3 class="text-primary">S/ @Model.Precio.ToString("N0")</h3>
                            <p class="text-muted">Precio</p>

                            @if (reservaActiva)
                            {
                                <div class="alert alert-warning">
                                    ⚠️ <strong>Reservado</strong><br>
                                    Este inmueble tiene una reserva activa.
                                </div>
                            }

                            @if (User.Identity.IsAuthenticated)
                            {
                                <a href="@Url.Action("AgendarVisita", "Visitas", new { inmuebleId = Model.Id })" 
                                   class="btn btn-success btn-lg mt-2">
                                    📅 Agendar Visita
                                </a>
                                @if (!reservaActiva)
                                {
                                    <form method="post" asp-action="Reservar" asp-route-id="@Model.Id">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-warning btn-lg" 
                                                onclick="return confirm('¿Estás seguro de que quieres reservar este inmueble por 48 horas?')">
                                            🔒 Reservar Ahora (48h)
                                        </button>
                                    </form>
                                }
                            }
                            else
                            {
                                <p class="text-warning mt-2">
                                    <a asp-area="Identity" asp-page="/Account/Login">Inicia sesión</a> para agendar una visita
                                </p>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="mb-4">
                <h4>Descripción</h4>
                <p>@(string.IsNullOrEmpty(Model.Descripcion) ? "No hay descripción disponible." : Model.Descripcion)</p>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Index" class="btn btn-secondary">
            ← Volver al Catálogo
        </a>
    </div>
</div>

@{
    public async Task<IActionResult> Details(int? id)
    {
        if (id == null)
            return NotFound();

        var inmueble = await _context.Inmuebles.FindAsync(id);

        if (inmueble == null)
            return NotFound();

        return View(inmueble);
    }
}