@using PortalInmobiliario.Services
@inject ICacheService CacheService

<!DOCTYPE html>
<html lang="es">
<head>
    <!-- head content -->
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <!-- logo y menú principal -->
                
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Inmuebles" asp-action="Index">Catálogo</a>
                        </li>
                        
                        <!-- Atajos de sesión -->
                        @{
                            var ultimosFiltros = await CacheService.ObtenerFiltrosDeSesionAsync();
                            var ultimoInmueble = await CacheService.ObtenerUltimoInmuebleVisitadoAsync();
                        }
                        
                        @if (ultimosFiltros != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-info" 
                                   asp-controller="Inmuebles" 
                                   asp-action="Index"
                                   asp-route-ciudad="@ultimosFiltros.Ciudad"
                                   asp-route-tipo="@ultimosFiltros.Tipo"
                                   asp-route-precioMin="@ultimosFiltros.PrecioMin"
                                   asp-route-precioMax="@ultimosFiltros.PrecioMax"
                                   asp-route-dormitorios="@ultimosFiltros.Dormitorios">
                                    <i class="fas fa-history"></i> Última Búsqueda
                                </a>
                            </li>
                        }
                        
                        @if (ultimoInmueble.inmuebleId.HasValue)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-success" 
                                   asp-controller="Inmuebles" 
                                   asp-action="Details" 
                                   asp-route-id="@ultimoInmueble.inmuebleId">
                                    <i class="fas fa-arrow-left"></i> Volver a @ultimoInmueble.titulo
                                </a>
                            </li>
                        }
                    </ul>
                    
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - pc2_progra - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
