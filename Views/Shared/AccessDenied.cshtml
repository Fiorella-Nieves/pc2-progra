@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h2><i class="fas fa-exclamation-triangle"></i> @ViewData["Title"]</h2>
                </div>
                <div class="card-body">
                    <p class="lead">No tienes permisos para acceder a esta sección.</p>
                    <p>Si crees que esto es un error, contacta al administrador del sistema.</p>
                    
                    <div class="mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                            <i class="fas fa-home"></i> Volver al Inicio
                        </a>
                        <a asp-controller="Inmuebles" asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-building"></i> Ir al Catálogo
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>